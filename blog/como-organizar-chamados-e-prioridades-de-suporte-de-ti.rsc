ação e mudança"}]}],["$","li","Defina prazos que a equipe consegue cumprir",{"children":["$","a",null,{"href":"#secao-5","children":"Defina prazos que a equipe consegue cumprir"}]}],["$","li","Comunique andamento sem linguagem técnica excessiva",{"children":"$L15"}],"$L16","$L17","$L18"]}]]}],"$L19"]}]]}],"$L1a"]}]
15:["$","a",null,{"href":"#secao-6","children":"Comunique andamento sem linguagem técnica excessiva"}]
