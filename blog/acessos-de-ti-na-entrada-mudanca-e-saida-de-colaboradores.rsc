repare equipamentos antes do primeiro dia"}]}],["$","li","Revise acessos quando a função muda",{"children":["$","a",null,{"href":"#secao-5","children":"Revise acessos quando a função muda"}]}],["$","li","Planeje o desligamento com ordem e horário definidos",{"children":"$L15"}],"$L16","$L17","$L18"]}]]}],"$L19"]}]]}],"$L1a"]}]
15:["$","a",null,{"href":"#secao-6","children":"Planeje o desligamento com ordem e horário definidos"}]
16:["$","li","Inclua serviços que não são administrados pela TI",{"children":["$","a",null,{"href":"#secao-7","children":"Inclua serviços que não são administrados pela TI"}]}]
