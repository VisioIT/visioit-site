18:["$","section","O que uma revisão deve verificar",{"id":"secao-3","children":[["$","span",null,{"children":["0",3]}],["$","h2",null,{"children":"O que uma revisão deve verificar"}],[["$","p","O diagnóstico deve combinar inspeção física e análise lógica. O objetivo é localizar gargalos, riscos e dependências antes de recomendar compras.",{"children":"O diagnóstico deve combinar inspeção física e análise lógica. O objetivo é localizar gargalos, riscos e dependências antes de recomendar compras."}]],["$","ul",null,{"children":[["$","li","Topologia e documentação",{"children":"Topologia e documentação"}],["$","li","Estado e categoria do cabeamento",{"children":"Estado e categoria do cabeamento"}],["$","li","Cobertura e interferência do Wi-Fi",{"children":"Cobertura e interferência do Wi-Fi"}],["$","li","Capacidade dos switches e pontos de acesso",{"children":"Capacidade dos switches e pontos de acesso"}],["$","li","Segmentação de dispositivos e visitantes",{"children":"Segmentação de dispositivos e visitantes"}],["$","li","Redundância dos pontos críticos",{"children":"Redundância dos pontos críticos"}]]}]]}]
